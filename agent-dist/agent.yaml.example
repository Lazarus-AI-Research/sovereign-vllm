# Sovereign host inference agent configuration (~/.sovereign/agent.yaml).
# Models are GGUF files on the host; weights live in the deploy ./models
# mount so container and host share one copy.
#
# The agent serves deployments only. Sovereign Control creates them through
# the authenticated admin API (the shipped assistant among them) and the agent
# records each one here so a restart serves it again. Nothing is served until
# Control asks.

listen: 127.0.0.1
port: 9100
token_env: SOVEREIGN_AGENT_TOKEN
llama_server: __AGENT_HOME__/runtime/bin/llama-server
sd_server: __AGENT_HOME__/runtime/bin/sd-server

deployments: {}
